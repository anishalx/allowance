# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
# In the app settings, enable: "Save payment methods" (Vault), Payouts, Transaction search
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox test accounts (Testing tools -> Sandbox accounts). Use US region for both.
# Buyer = the person who gives agents an allowance. Merchant = a store an agent pays.
SANDBOX_BUYER_EMAIL=
SANDBOX_MERCHANT_EMAIL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Where PayPal redirects after the buyer approves vaulting (any URL works for the spike)
APP_BASE_URL=http://localhost:3000

# Database: a local SQLite file by default (zero setup). For hosting, point at Turso (hosted libSQL).
# DATABASE_URL=libsql://allowance-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Optional
# PAYPAL_WEBHOOK_ID=            # auto-registered on https deployments when unset
# PUBLIC_DEMO=1                # give each browser a private demo household (always on when hosted on Render)
# OWNER_TOKEN=                  # secret for /?owner=<token>; derived from PAYPAL_CLIENT_SECRET when unset
# AI_UNITS_PER_VISITOR=150      # public demo: daily AI budget per visitor (an agent run is 10, a compile or audit 1)
# AI_UNITS_PER_DAY=1000         # public demo: daily AI budget for all visitors together (the owner is never capped)
