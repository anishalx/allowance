# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
# In the app settings, enable: "Save payment methods" (Vault), Payouts, Transaction search
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox test accounts (Testing tools -> Sandbox accounts). Use US region for both.
# Buyer = the person who gives agents an allowance. Merchant = a store an agent pays.
SANDBOX_BUYER_EMAIL=
SANDBOX_MERCHANT_EMAIL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Where PayPal redirects after the buyer approves vaulting (any URL works for the spike)
APP_BASE_URL=http://localhost:3000
